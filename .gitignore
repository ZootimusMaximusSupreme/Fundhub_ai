# Trailing slash does not match a symlink; use node_modules.
node_modules
.env
.env.*
!.env.example
*.log
.DS_Store
.vercel

# Subagent worktrees — scratch checkouts, never part of a commit.
.claude/worktrees/

# Real credentials. Never committed, on purpose — see credentials/README.md.
credentials/
test-results/
playwright-report/

# generated by docs/workflows/mobile-check.mjs --shots
.mobile-shots/

# Local Netlify folder
.netlify

# Gate relay runtime (gate files, decisions, poll offset). May hold voice transcripts.
.fundhub-relay/

# Workflow evidence dumps (screenshots/JSON prove trees). Boards (*.md) stay tracked.
# Index untrack done 2026-08-24 (W2 wrap). Files stay on disk.
docs/workflows/*-evidence/
docs/workflows/**/*-evidence/
docs/workflows/*/evidence/
docs/workflows/fix-*/evidence/

# Local-only doc scratch (from older purge notes)
docs/artifacts/
docs/jokes/
.playwright-mcp/

# Fake walk documents print the fake identity from credentials/, so they stay local.
# The pass/fail matrix beside them is committed.
docs/workflows/sim-documents/*
!docs/workflows/sim-documents/MATRIX.md
