+<!-- fh-book-confirm:start v1 -->
+<!--
+  /funding-book-call — booking-accepted layer (page 25062844, native AppointmentScheduler).
+  Pushed into the page's footer_code as one marked block by
+  scripts/cf-push-custom-html.mjs (manifest row "apply-book", footerBlocks). The body,
+  the old fh_booking_v1 writer in the body and the calendar are never touched.
+  Nothing here changes what the visitor sees, and nothing here can throw into the page.
+
+  The one success signal: ClickFunnels' own lander code (user_pages submit.ts,
+  submitPage) dispatches document event "cf:form_submitted:ok" only when its POST of
+  the booking form comes back ok, in the same branch that sends the visitor on to the
+  next step (/thank-you). A Book press ClickFunnels refuses never reaches it: a bad
+  phone stops in checkValidInputs (no POST at all), a 422 or any other error fires
+  "checkout:order-submit-errors" instead, and a network failure fires
+  "payments:submit-failed". The Book press alone ("cf:form_submitted") is ignored.
+
+  At that moment this block:
+    1. tells the tracker booking_confirmed (framed: postMessage to the parent page
+       on https://apply.fundhub.ai; opened directly: fhTrack, or the fhq queue);
+    2. re-reads fh_booking_v1 (written by the old body writer on the Book press,
+       before the POST), adds submittedAt, and writes it back to localStorage and
+       sessionStorage, so the listeners on /apply and /roadmap-book fire. For a few
+       seconds after, a rewrite of the same booking without submittedAt (the old
+       writer's 400ms loop) gets the stamp put back.
+  Before that: calendar_view once the scheduler has drawn its calendar (Cronofy has
+  put something in #cronofy-date-time-picker), and time_selected each time
+  ClickFunnels takes a new time into its form (start_on filled, #formContainer open).
+-->
+<script>
+(function(){
+  try{
+    if(window.__fhBookConfirm) return;
+    window.__fhBookConfirm=1;
+  }catch(e){ return; }
+  var KEY='fh_booking_v1',CAL='funding-book-call',PARENT='https://apply.fundhub.ai';
+  var SCHED='[data-page-element="AppointmentScheduler/V1"]';
+  var framed=false,parentOk=null,viewed=false,lastStart='',confirmed=false,stamped=null,stampedRaw='';
+  try{ framed=window.self!==window.top; }catch(e){ framed=true; }
+  function parentOrigin(){
+    try{ return window.parent.location.origin; }catch(e){}
+    try{ var a=window.location.ancestorOrigins; if(a&&a.length) return a[0]; }catch(e){}
+    try{ return new URL(document.referrer).origin; }catch(e){}
+    return '';
+  }
+  // Framed: the parent page's tracker passes it on. Framed anywhere else (a preview,
+  // the builder): say nothing. Opened directly: this page sends it itself.
+  function send(event){
+    var msg={fh:'track',event:event,props:{calendar:CAL}};
+    try{
+      if(framed){
+        if(parentOk===null) parentOk=parentOrigin()===PARENT;
+        if(parentOk) window.parent.postMessage(msg,PARENT);
+        return;
+      }
+      (window.fhTrack||function(e,p){(window.fhq=window.fhq||[]).push([e,p]);})(msg.event,msg.props);
+    }catch(e){}
+  }
+  function val(root,sel){
+    var el=root&&root.querySelector(sel);
+    return el&&el.value?String(el.value):'';
+  }
+  // The same record the old writer saves, read from the scheduler's own fields.
+  function readForm(){
+    var root=document.querySelector(SCHED);
+    if(!root) return null;
+    var start=val(root,'#appointment_schedule_request_start_on');
+    var end=val(root,'#appointment_schedule_request_end_on');
+    if(!start||!end) return null;
+    var ts=root.querySelector('#timeString');
+    return {
+      start:start,end:end,tz:val(root,'#appointment_schedule_request_tzid'),
+      name:val(root,'input[name="name"]'),email:val(root,'input[name="email"]'),
+      phone:val(root,'input[name="phone_number"]'),
+      timeString:(ts&&ts.textContent)||'',
+      title:'Funding Strategy Meeting — Fundhub',
+      capturedAt:Date.now()
+    };
+  }
+  function readStored(){
+    var raw=null;
+    try{ raw=localStorage.getItem(KEY); }catch(e){}
+    if(!raw){ try{ raw=sessionStorage.getItem(KEY); }catch(e){} }
+    try{ var d=JSON.parse(raw||'null'); return d&&typeof d==='object'?d:null; }catch(e){ return null; }
+  }
+  function write(raw){
+    try{ localStorage.setItem(KEY,raw); }catch(e){}
+    try{ sessionStorage.setItem(KEY,raw); }catch(e){}
+  }
+  function stamp(req){
