+    assert.equal(cleanProps("page_view", { title: "  Fundhub\n\t—  Roadmap " }).title, "Fundhub — Roadmap");
+    assert.deepEqual(cleanProps("faq_open", { question: "!!!" }), {}, "a slug that cleans to nothing is dropped");
