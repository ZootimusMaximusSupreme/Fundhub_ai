+    try{
+      var d=JSON.parse(raw||'null');
+      if(d&&!d.submittedAt&&d.start===stamped.start) write(stampedRaw);
+    }catch(e){}
+  }
+  function onAccepted(ev){
+    if(confirmed) return;
+    try{
+      var detail=ev&&ev.detail,req=detail&&detail.appointments_schedule_request;
+      var form=readForm();
+      // Only a submit that carried a picked time is a booking.
+      if(!(req&&req.start_on)&&!form) return;
+      confirmed=true;
+      send('booking_confirmed');
+      stamp(req);
+      var n=0,g=setInterval(function(){ keep(); if(++n>=40) clearInterval(g); },150);
+      window.addEventListener('pagehide',keep);
+    }catch(e){}
+  }
+  function tick(){
+    try{
