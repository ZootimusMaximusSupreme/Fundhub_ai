+    write(stampedRaw);
+  }
+  // The old writer rewrites the record (no submittedAt) whenever the fields change.
+  // Same booking back without the stamp: put the stamp back.
+  function keep(){
+    if(!stamped) return;
+    var raw=null;
+    try{ raw=localStorage.getItem(KEY); }catch(e){ return; }
